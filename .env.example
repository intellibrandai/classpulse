# ClassPulse local development settings (copy to .env; .env is never committed).
# Every value below is a fictitious/throwaway local default. Production values are NOT kept in this repository.

# --- Application -----------------------------------------------------------------------------------
APP_NAME=ClassPulse
APP_ENV=local
# Leave APP_KEY empty here; `php artisan key:generate` fills it in your own .env.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
# "Today" and school days are computed in this timezone (see app/Support/SchoolCalendar.php).
APP_TIMEZONE=America/Toronto

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------------------------------
# Local Docker values only (throwaway; they match the `db` service in docker-compose.yml).
# Tests use a separate database (`classpulse_test`, see phpunit.xml), never this one.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=classpulse
DB_USERNAME=classpulse
DB_PASSWORD=classpulse_local

# --- Sessions --------------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true behind HTTPS (production); false for http://localhost.
SESSION_SECURE_COOKIE=false

# --- Cache, queue, files, mail (kept simple: no external services) ---------------------------------
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Docker Compose host ports ---------------------------------------------------------------------
# Read by docker compose for port interpolation only; Laravel ignores them. Change them if 8090 or
# 33061 are already in use on your machine.
CLASSPULSE_WEB_PORT=8090
CLASSPULSE_DB_PORT=33061
