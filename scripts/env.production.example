# ClassPulse production settings TEMPLATE (placeholders only; no real values are kept in this repository).
# In the Hostinger File Manager, copy this file to ".env" (same folder) and replace every value that starts with
# CAMBIAR. Never upload the local .env, and never reuse the local APP_KEY.
APP_NAME=ClassPulse
APP_ENV=production
APP_KEY=CAMBIAR_APP_KEY
APP_DEBUG=false
APP_URL=https://CAMBIAR_DOMINIO
APP_TIMEZONE=America/Toronto

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CAMBIAR_BASE
DB_USERNAME=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_CONTRASENA

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
